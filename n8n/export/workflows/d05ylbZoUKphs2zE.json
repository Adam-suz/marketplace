    {
      "id": "a19638e2-3018-42bb-969f-ffdd552c4c9c",
      "name": "Preparer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "jsCode": "const d = $input.all()[0].json;\nconst dt = d.date;\nconst orders = d.orders || [];\nconst raw = JSON.stringify(d, null, 2);\nconst vals = orders.map(o => `('${o.order_id}','${o.dt}','${o.customer_id}','${o.seller_id}','${o.product_id}',${o.quantity},${o.unit_price},${o.total},${o.commission},'${o.status}')`);\nconst cols = 'order_id, dt, seller_id, product_id, customer_id, quantity, unit_price, total, commission, status';\nconst loadFact = `INSERT INTO dwh.fact_orders (${cols}) SELECT s.${cols.split(', ').join(', s.')} FROM staging.orders s JOIN dwh.dim_seller ds ON ds.seller_id = s.seller_id JOIN dwh.dim_product dp ON dp.product_id = s.product_id WHERE s.dt = '${dt}';`;\nconst summary = `INSERT INTO analytics.daily_summary (dt, total_orders, total_revenue, avg_basket, total_commission, top_seller_id) SELECT f.dt, COUNT(*), SUM(f.total), ROUND(AVG(f.total),2), SUM(f.commission), (SELECT f2.seller_id FROM dwh.fact_orders f2 WHERE f2.dt = f.dt AND f2.status <> 'cancelled' GROUP BY f2.seller_id ORDER BY SUM(f2.total) DESC LIMIT 1) FROM dwh.fact_orders f WHERE f.dt = '${dt}' AND f.status <> 'cancelled' GROUP BY f.dt ON CONFLICT (dt) DO UPDATE SET total_orders=EXCLUDED.total_orders, total_revenue=EXCLUDED.total_revenue, avg_basket=EXCLUDED.avg_basket, total_commission=EXCLUDED.total_commission, top_seller_id=EXCLUDED.top_seller_id;`;\nconst sellerDaily = `INSERT INTO analytics.seller_daily (dt, seller_id, nb_orders, revenue, commission) SELECT f.dt, f.seller_id, COUNT(*), SUM(f.total), SUM(f.commission) FROM dwh.fact_orders f WHERE f.dt = '${dt}' AND f.status <> 'cancelled' GROUP BY f.dt, f.seller_id ON CONFLICT (dt, seller_id) DO UPDATE SET nb_orders=EXCLUDED.nb_orders, revenue=EXCLUDED.revenue, commission=EXCLUDED.commission;`;\nconst catDaily = `INSERT INTO analytics.category_daily (dt, category, nb_orders, revenue) SELECT f.dt, dp.category, COUNT(*), SUM(f.total) FROM dwh.fact_orders f JOIN dwh.dim_product dp ON dp.product_id = f.product_id WHERE f.dt = '${dt}' AND f.status <> 'cancelled' GROUP BY f.dt, dp.category ON CONFLICT (dt, category) DO UPDATE SET nb_orders=EXCLUDED.nb_orders, revenue=EXCLUDED.revenue;`;\nconst log = `INSERT INTO staging.file_ingestion_log (object_key, bucket_name, source, status, message) VALUES ('raw/orders/dt=${dt}/orders.json', 'data-lake', 'api-marketplace', 'SUCCESS', '${orders.length} commandes');`;\nconst CHUNK = 3000;\nconst staging_chunks = [];\nfor (let i = 0; i < vals.length; i += CHUNK) {\n  staging_chunks.push(`INSERT INTO staging.orders (order_id, dt, customer_id, seller_id, product_id, quantity, unit_price, total, commission, status) VALUES ${vals.slice(i, i + CHUNK).join(',')};`);\n}\nreturn [{ json: {\n  dt, nb_orders: orders.length,\n  raw_content: raw,\n  raw_key: `raw/orders/dt=${dt}/orders.json`,\n  purge_staging: `DELETE FROM staging.orders WHERE dt='${dt}';`,\n  staging_chunks: staging_chunks,\n  purge_fact: `DELETE FROM dwh.fact_orders WHERE dt='${dt}';`,\n  load_fact: loadFact,\n  upsert_summary: summary,\n  upsert_seller_daily: sellerDaily,\n  upsert_category_daily: catDaily,\n  log_ingestion: log\n} }];"
      }
    },
