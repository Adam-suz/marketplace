      "id": "b62f722b-94de-4eea-a05d-3d0d8c1e303c",
      "name": "Schedule quotidien",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -656,
        112
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH last_day AS (SELECT max(dt) AS dt FROM analytics.daily_summary), moy AS (SELECT AVG(total_revenue) AS avg7 FROM analytics.daily_summary WHERE dt >= (SELECT dt FROM last_day) - 7 AND dt < (SELECT dt FROM last_day)) SELECT s.dt, s.total_revenue, ROUND(moy.avg7, 2) AS avg7, ROUND(s.total_revenue / NULLIF(moy.avg7, 0), 3) AS ratio FROM analytics.daily_summary s, moy, last_day l WHERE s.dt = l.dt;",
        "options": {}
      },
      "id": "0067917c-aaa0-4370-b69a-34e530ed88ab",
      "name": "CA vs moyenne 7j",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -448,
        112
      ],
      "credentials": {
        "postgres": {
          "id": "cGGI0jSGUZrIPBuW",
          "name": "Postgres account"
        }
      },
      "notes": "ratio = CA du dernier jour / moyenne mobile des 7 jours precedents."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-ratio",
              "leftValue": "={{ $json.ratio }}",
              "rightValue": 0.7,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "656c1dad-f753-42cb-b42b-81b6a00cf944",
      "name": "CA < 70% moyenne ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -224,
        112
      ],
      "notes": "US-05 : alerte si le CA du jour < 70% de la moyenne sur 7 jours."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO analytics.alerts (dt, alert_type, message) VALUES ('{{ $('CA vs moyenne 7j').item.json.dt }}', 'CA_DROP', 'CA {{ $('CA vs moyenne 7j').item.json.total_revenue }} EUR = {{ $('CA vs moyenne 7j').item.json.ratio }} x moyenne 7j ({{ $('CA vs moyenne 7j').item.json.avg7 }} EUR)');",
        "options": {}
      },
      "id": "b409a7d2-a72e-4aec-b15d-81989e6d5d50",
      "name": "Enregistrer alerte",
