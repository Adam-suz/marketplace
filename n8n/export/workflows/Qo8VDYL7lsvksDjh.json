      "id": "5231fea3-d92d-4be7-a611-8bd296cfb5d3",
      "name": "Preparer dim_seller",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "const sellers = $input.all()[0].json.sellers || [];\nconst esc = v => String(v).replace(/'/g, \"''\");\nconst vals = sellers.map(s => `('${s.seller_id}','${esc(s.name)}','${s.country}','${esc(s.city)}','${s.joined_date}',${s.rating})`);\nconst query = `INSERT INTO dwh.dim_seller (seller_id, name, country, city, joined_date, rating) VALUES ${vals.join(',')} ON CONFLICT (seller_id) DO UPDATE SET name=EXCLUDED.name, country=EXCLUDED.country, city=EXCLUDED.city, joined_date=EXCLUDED.joined_date, rating=EXCLUDED.rating;`;\nreturn [{ json: { query, nb_sellers: sellers.length } }];"
      }
    },
